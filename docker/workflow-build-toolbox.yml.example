# DRAFT CI for the arcint toolbox images — modeled on
# kyuz0/intel-b70-ai-toolboxes build_and_publish.yml + poll-llama-cpp.yml,
# adapted to the two-tier split (INVESTIGATION.md §4).
#
# Kept as an .example in docker/ so this investigation branch does not fire
# workflows. To adopt: move to .github/workflows/build-toolbox.yml, set the
# registry/owner, and confirm the tier-1 wheel fetch still resolves
# (INVESTIGATION.md §5.4).
#
# Notes:
# - GitHub-hosted runners have no Intel GPU. The gates here are the
#   device-free ones: ctest -L unit (inside the tier-2 build) and the stub
#   /props smoke test. Card-requiring acceptance cells stay out of CI by
#   design (docs/design-0.3.1-test-ladder.md). A self-hosted Arc runner
#   could later run tests/acceptance/run.py against the built image.
# - Tier 1 is a ~35+ minute build; the disk cleanup step is copied from
#   kyuz0 because the OpenVINO clone+build eats the runner's 14 GB free.

name: Build arcint toolbox images

on:
  workflow_dispatch:
    inputs:
      tiers:
        description: 'Comma-separated tiers to build: ov,arcint,all'
        required: false
        default: arcint
  push:
    paths:
      - 'src/**'
      - 'CMakeLists.txt'
      - 'cmake/**'
      - 'third_party/**'
      - 'models/allowlist-raw.json'
      - 'docker/Dockerfile.arcint'
  # Tier 1 only rebuilds when the patch series or its recipe moves:
  # add 'contrib/packaging/marfrit-openvino/**' to a separate trigger or
  # dispatch tiers=ov when the pin/patches change.

env:
  REGISTRY: ghcr.io
  OV_IMAGE: ${{ github.repository_owner }}/arcint-ov
  OV_TAG: 2026.4.0-marfrit-p16
  ENGINE_IMAGE: ${{ github.repository_owner }}/arcint

jobs:
  tier1-openvino:
    if: ${{ github.event_name == 'workflow_dispatch' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Free up runner disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          docker system prune --all --force
          docker builder prune --all --force

      - uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build patched OpenVINO base
        run: |
          docker build \
            -t ${{ env.REGISTRY }}/${{ env.OV_IMAGE }}:${{ env.OV_TAG }} \
            -f docker/Dockerfile.openvino-patched .

      - name: Push (immutable: tag carries pin + patch level)
        run: docker push ${{ env.REGISTRY }}/${{ env.OV_IMAGE }}:${{ env.OV_TAG }}

  tier2-engine:
    needs: [tier1-openvino]
    # When tier 1 is not part of this run (push events), depend on the
    # published base instead; never run on a failed tier-1 rebuild.
    if: ${{ needs.tier1-openvino.result == 'success' || needs.tier1-openvino.result == 'skipped' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Set build timestamp
        run: echo "BUILD_TS=$(date +%Y%m%dT%H%M%S)" >> "$GITHUB_ENV"

      - name: Build engine image
        run: |
          docker build \
            --build-arg OV_BASE=${{ env.REGISTRY }}/${{ env.OV_IMAGE }}:${{ env.OV_TAG }} \
            --build-arg ARCINT_GIT_SHA=${GITHUB_SHA::12} \
            -t ${{ env.REGISTRY }}/${{ env.ENGINE_IMAGE }}:build-${{ env.BUILD_TS }} \
            -f docker/Dockerfile.arcint .

      # The device-free smoke test already ran inside the build (stub +
      # /props). Re-run here against the final image before publishing the
      # channel tag (kyuz0's immutable→channel discipline).
      - name: Smoke test
        run: |
          docker run --rm ${{ env.REGISTRY }}/${{ env.ENGINE_IMAGE }}:build-${{ env.BUILD_TS}} \
            --stub --port 8090 &
          sleep 3
          curl -fsS http://127.0.0.1:8090/props > /dev/null
          kill %1

      - name: Push immutable + channel tags
        run: |
          docker tag ${{ env.REGISTRY }}/${{ env.ENGINE_IMAGE }}:build-${{ env.BUILD_TS }} \
                   ${{ env.REGISTRY }}/${{ env.ENGINE_IMAGE }}:${{ env.BUILD_TS }}
          docker push ${{ env.REGISTRY }}/${{ env.ENGINE_IMAGE }}:${{ env.BUILD_TS }}
          docker tag ${{ env.REGISTRY }}/${{ env.ENGINE_IMAGE }}:build-${{ env.BUILD_TS }} \
                   ${{ env.REGISTRY }}/${{ env.ENGINE_IMAGE }}:latest
          docker push ${{ env.REGISTRY }}/${{ env.ENGINE_IMAGE }}:latest
