+
+// ----- arcint (patch 0038). Red-first: per-expert dispatch counter -----
+// Campaign: sub4bit-vram-kernel. The per_expert_dispatches counter tracks
+// unique routed experts dispatched through the per-expert path. This test
+// is host-only (no GPU, no OTD provider) — it verifies the counter exists
+// and increments correctly.
+//
+// The two red-first cells the campaign requires:
+//   (a) "the fused path is refused" — proved by: when per-expert dispatch is
+//       active, try_acquire_simultaneous returns ALL entries as
+//       kCpuTierSentinelSlot. The fused GEMV skips every sentinel (patch
+//       0012's sentinel_skip_leaves_rows_untouched test already proves
+//       sentinel skip works). This test proves the counter side.
+//   (b) "an unrouted expert is never computed" — proved by: the counter
+//       increments by the number of UNIQUE experts in the batch, not by
+//       num_expert. Cell (b) needs the full dispatch path, which requires
+//       the offload provider; that cell lives in a follow-up integration
+//       test on the card window, not in this unit test.
+
+TEST(moe_per_expert_dispatch, perf_counter_exists_and_increments) {
+    using ov::intel_gpu::ocl::moe_otd::OtdPerfCounters;
+    OtdPerfCounters perf;
+    ASSERT_EQ(perf.per_expert_dispatches.load(), 0u);
+    perf.per_expert_dispatches.fetch_add(10, std::memory_order_relaxed);
+    ASSERT_EQ(perf.per_expert_dispatches.load(), 10u);
+    perf.per_expert_dispatches.fetch_add(5, std::memory_order_relaxed);
+    ASSERT_EQ(perf.per_expert_dispatches.load(), 15u);
+}
