 static constexpr Property<size_t, PropertyMutability::RW> moe_cpu_tier_threads{"MOE_CPU_TIER_THREADS"};

+/**
+ * @brief When true, ALL routed MoE experts bypass the fused GEMV path and
+ * are dispatched individually — initially through the CPU tier (patch 0011),
+ * later through a per-expert GPU kernel. false (default) keeps the existing
+ * fused path. Requires offload_ratio > 0 and implicitly enables moe_cpu_tier.
+ * Campaign: sub4bit-vram-kernel.
+ * @ingroup ov_runtime_ocl_gpu_prop_cpp_api
+ */
+static constexpr Property<bool, PropertyMutability::RW> moe_per_expert_dispatch{"MOE_PER_EXPERT_DISPATCH"};
+
